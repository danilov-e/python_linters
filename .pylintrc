[MAIN]
py-version=3.10

; Не анализируем служебные каталоги
ignore=.venv,.ruff_cache

; Не выводим итоговые отчёты
; reports=no


[MESSAGES CONTROL]

; Отключение обязательных docstring
; disable=
    missing-module-docstring,
    missing-function-docstring,
    missing-class-docstring


[BASIC]

; Допускаем короткие имена для типичных счётчиков
; good-names=i,j,k,id

; Подсказываем правильный стиль именования
; include-naming-hint=yes

; argument-naming-style=snake_case
; function-naming-style=snake_case
; class-naming-style=PascalCase


[FORMAT]

; Синхронизируем ограничение с Flake8 и Ruff
; max-line-length=100

; Четыре пробела для отступа
; indent-string="    "


[DESIGN]

; Делаем ограничения специально заметными в нашем эксперименте
; max-args=6
; max-branches=8
; max-complexity=8
; max-locals=10
; max-statements=40


[REFACTORING]

; Не допускаем слишком глубокой вложенности
; max-nested-blocks=3


[SIMILARITIES]

; Порог для поиска похожего кода
; min-similarity-lines=4